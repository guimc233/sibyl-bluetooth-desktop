<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>SibylEarbuds.App</RootNamespace>
    <AssemblyName>SibylEarbudsManager</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- WinUI 3 / Windows App SDK -->
    <UseWinUI>true</UseWinUI>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <!-- Unpackaged, self-contained distribution (no MSIX, no runtime install required) -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(RuntimeIdentifier)' != ''">true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <!--
    MrtCore PriGen uses Microsoft.Build.Packaging.Pri.Tasks.dll, which ships with
    Visual Studio (not the .NET SDK). Point AppxMSBuildToolsPath at an installed
    VS instance on CI/dev machines that run `dotnet publish` directly.
  -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <_AppxTaskBase Condition="Exists('C:\Program Files\Microsoft Visual Studio\18\Enterprise\MSBuild\Microsoft\VisualStudio\v18.0\AppxPackage')">C:\Program Files\Microsoft Visual Studio\18\Enterprise\MSBuild\Microsoft\VisualStudio\v18.0\AppxPackage</_AppxTaskBase>
    <_AppxTaskBase Condition="'$(_AppxTaskBase)' == '' And Exists('C:\Program Files\Microsoft Visual Studio\18\Enterprise\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage')">C:\Program Files\Microsoft Visual Studio\18\Enterprise\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage</_AppxTaskBase>
    <_AppxTaskBase Condition="'$(_AppxTaskBase)' == '' And Exists('C:\Program Files\Microsoft Visual Studio\2022\Enterprise\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage')">C:\Program Files\Microsoft Visual Studio\2022\Enterprise\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage</_AppxTaskBase>
    <_AppxTaskBase Condition="'$(_AppxTaskBase)' == '' And Exists('C:\Program Files\Microsoft Visual Studio\2022\Professional\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage')">C:\Program Files\Microsoft Visual Studio\2022\Professional\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage</_AppxTaskBase>
    <_AppxTaskBase Condition="'$(_AppxTaskBase)' == '' And Exists('C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage')">C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage</_AppxTaskBase>
    <_AppxTaskBase Condition="'$(_AppxTaskBase)' == '' And Exists('C:\Program Files\Microsoft Visual Studio\2022\BuildTools\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage')">C:\Program Files\Microsoft Visual Studio\2022\BuildTools\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage</_AppxTaskBase>
    <_AppxTaskBase Condition="'$(_AppxTaskBase)' == '' And Exists('C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage')">C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage</_AppxTaskBase>
    <AppxMSBuildToolsPath Condition="'$(AppxMSBuildToolsPath)' == '' And '$(_AppxTaskBase)' != ''">$(_AppxTaskBase)</AppxMSBuildToolsPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SibylEarbuds.Core\SibylEarbuds.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Audio\*.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Images\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
