<UserControl x:Class="SibylEarbuds.App.Controls.BatteryRingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="100">
    <Grid>
        <Border Background="#1AFFFFFF" CornerRadius="16" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="12">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="60" Height="60">
                    <!-- 背景灰色外环 -->
                    <Ellipse Stroke="#26FFFFFF" StrokeThickness="4" Width="56" Height="56"/>
                    <!-- 进度环使用 Arc/Path 或动态绘制，这里使用圆角进度条或中心显示 -->
                    <Ellipse x:Name="RingIndicator" Stroke="#10B981" StrokeThickness="4" Width="56" Height="56" 
                             StrokeDashArray="100 100" StrokeDashOffset="20"/>
                    
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtPercent" Text="85%" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="#F9FAFB" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtCharging" Text="⚡" FontSize="10" Foreground="#FBBF24" 
                                   HorizontalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="TxtLabel" Text="左耳 (L)" FontSize="12" Foreground="#9CA3AF" 
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
