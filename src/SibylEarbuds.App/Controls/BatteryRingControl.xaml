<UserControl x:Class="SibylEarbuds.App.Controls.BatteryRingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="140" d:DesignWidth="110">
    <Grid>
        <Border Background="#1AFFFFFF" CornerRadius="16" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="8">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- 真实耳机硬件造型图片 -->
                <Border Width="40" Height="40" Background="#111827" CornerRadius="8" Margin="0,0,0,6" HorizontalAlignment="Center">
                    <Image x:Name="ImgDevice" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Grid Width="50" Height="50">
                    <!-- 背景灰色外环 -->
                    <Ellipse Stroke="#26FFFFFF" StrokeThickness="4" Width="46" Height="46"/>
                    <!-- 进度环使用圆环指示 -->
                    <Ellipse x:Name="RingIndicator" Stroke="#10B981" StrokeThickness="4" Width="46" Height="46" 
                             StrokeDashArray="100 100" StrokeDashOffset="20"/>
                    
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtPercent" Text="85%" FontSize="13" FontWeight="SemiBold" 
                                   Foreground="#F9FAFB" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtCharging" Text="⚡" FontSize="10" Foreground="#FBBF24" 
                                   HorizontalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="TxtLabel" Text="左耳 (L)" FontSize="11" Foreground="#9CA3AF" 
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
