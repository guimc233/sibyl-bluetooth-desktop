<UserControl x:Class="SibylEarbuds.App.Controls.EarbudVisualControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="130" d:DesignWidth="100">
    <Grid>
        <Border Background="#111827" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="6">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- 真实耳机主体几何图形与材质渲染 -->
                <Viewbox Width="52" Height="64" Stretch="Uniform" Margin="0,2,0,4">
                    <Grid Width="60" Height="74">
                        <!-- 充电盒造型 (当 BoxMode 为 True) -->
                        <Grid x:Name="BoxVisual" Visibility="Collapsed">
                            <Border Width="56" Height="48" CornerRadius="16" Background="#1E293B" BorderBrush="#475569" BorderThickness="2"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid>
                                    <!-- 开合中线缝隙 -->
                                    <Border Height="1" Background="#334155" VerticalAlignment="Top" Margin="0,14,0,0"/>
                                    <!-- LED 呼吸指示灯 -->
                                    <Ellipse x:Name="BoxLed" Width="6" Height="6" Fill="#10B981" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 耳机入耳式造型 (左耳或右耳) -->
                        <Canvas x:Name="EarbudVisual" Width="60" Height="74">
                            <!-- 耳塞硅胶套与出音嘴 -->
                            <Path x:Name="PathEartip" Fill="#374151" Stroke="#4B5563" StrokeThickness="1"
                                  Data="M 16,14 C 16,8 30,8 30,14 C 30,22 16,22 16,14 Z"/>
                            <!-- 耳机入耳式饱满腔体 -->
                            <Path x:Name="PathHead" Fill="#1E293B" Stroke="#475569" StrokeThickness="1.5"
                                  Data="M 20,12 C 34,10 46,20 44,34 C 42,44 32,48 24,44 C 18,40 14,24 20,12 Z"/>
                            <!-- 耳机耳柄 (Stem) -->
                            <Rectangle x:Name="RectStem" Width="10" Height="30" RadiusX="5" RadiusY="5"
                                       Fill="#0F172A" Stroke="#334155" StrokeThickness="1"
                                       Canvas.Left="26" Canvas.Top="38"/>
                            <!-- 触控感应凹槽 / 金属防尘网 / LED 状态指示 -->
                            <Ellipse x:Name="TouchSensor" Width="4" Height="4" Fill="#38BDF8"
                                     Canvas.Left="29" Canvas.Top="44"/>
                            <!-- 底部磁吸充电极片 -->
                            <Rectangle Width="6" Height="2" Fill="#F59E0B"
                                       Canvas.Left="28" Canvas.Top="65"/>
                        </Canvas>
                    </Grid>
                </Viewbox>

                <!-- 电量与状态 -->
                <TextBlock x:Name="TxtPercent" Text="85%" FontSize="13" FontWeight="Bold" 
                           Foreground="#F9FAFB" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtLabel" Text="左耳 (L)" FontSize="10" Foreground="#94A3B8" 
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
