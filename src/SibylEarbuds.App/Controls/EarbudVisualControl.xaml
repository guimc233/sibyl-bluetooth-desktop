<UserControl
    x:Class="SibylEarbuds.App.Controls.EarbudVisualControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Background="{ThemeResource ControlFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="8">
        <StackPanel HorizontalAlignment="Center" Spacing="4">

            <Viewbox Width="52" Height="64" Stretch="Uniform">
                <Grid Width="60" Height="74">

                    <!-- Charging case silhouette -->
                    <Grid x:Name="BoxVisual" Visibility="Collapsed">
                        <Border
                            Width="56"
                            Height="48"
                            CornerRadius="16"
                            Background="{ThemeResource EarbudBodyBrush}"
                            BorderBrush="{ThemeResource EarbudBodyStrokeBrush}"
                            BorderThickness="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Grid>
                                <Border
                                    Height="1"
                                    Background="{ThemeResource EarbudBodyStrokeBrush}"
                                    VerticalAlignment="Top"
                                    Margin="0,14,0,0" />
                                <Ellipse
                                    x:Name="BoxLed"
                                    Width="6"
                                    Height="6"
                                    Fill="{ThemeResource EarbudLedBrush}"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,10" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- In-ear bud silhouette -->
                    <Canvas x:Name="EarbudVisual" Width="60" Height="74">
                        <Path
                            Fill="{ThemeResource EarbudStemBrush}"
                            Stroke="{ThemeResource EarbudBodyStrokeBrush}"
                            StrokeThickness="1"
                            Data="M 16,14 C 16,8 30,8 30,14 C 30,22 16,22 16,14 Z" />
                        <Path
                            Fill="{ThemeResource EarbudBodyBrush}"
                            Stroke="{ThemeResource EarbudBodyStrokeBrush}"
                            StrokeThickness="1.5"
                            Data="M 20,12 C 34,10 46,20 44,34 C 42,44 32,48 24,44 C 18,40 14,24 20,12 Z" />
                        <Rectangle
                            Width="10"
                            Height="30"
                            RadiusX="5"
                            RadiusY="5"
                            Fill="{ThemeResource EarbudStemBrush}"
                            Stroke="{ThemeResource EarbudBodyStrokeBrush}"
                            StrokeThickness="1"
                            Canvas.Left="26"
                            Canvas.Top="38" />
                        <Ellipse
                            x:Name="TouchSensor"
                            Width="4"
                            Height="4"
                            Fill="{ThemeResource EarbudLedBrush}"
                            Canvas.Left="29"
                            Canvas.Top="44" />
                        <Rectangle
                            Width="6"
                            Height="2"
                            Fill="{ThemeResource EarbudChargingBrush}"
                            Canvas.Left="28"
                            Canvas.Top="65" />
                    </Canvas>
                </Grid>
            </Viewbox>

            <TextBlock
                x:Name="TxtPercent"
                Text="--"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                x:Name="TxtLabel"
                Text="左耳 (L)"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
