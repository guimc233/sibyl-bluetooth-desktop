<Window x:Class="SibylEarbuds.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SibylEarbuds.App"
        xmlns:vm="clr-namespace:SibylEarbuds.App.ViewModels"
        xmlns:controls="clr-namespace:SibylEarbuds.App.Controls"
        xmlns:converters="clr-namespace:SibylEarbuds.App.Converters"
        mc:Ignorable="d"
        Title="SIBYL MUSIC - 耳机控制中心" 
        Height="780" Width="1080" MinHeight="700" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#202020" Foreground="#FFFFFF"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:ReverseBoolConverter x:Key="RevBool"/>
        <converters:EqualsConverter x:Key="EqualsConv"/>

        <!-- WinUI 3 / Windows 11 Acrylic Mica 卡片样式 -->
        <Style x:Key="UwpCard" TargetType="Border">
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Windows 11 胶囊卡片 (可点击列表项) -->
        <Style x:Key="UwpItemCard" TargetType="Border">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#3D3D3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Windows 11 Fluent 主题强调按钮 (Accent Button) -->
        <Style x:Key="FluentAccentButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2B88D8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A86D9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#006CBE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 幽灵次级按钮 (Standard Button) -->
        <Style x:Key="FluentStandardButton" TargetType="Button">
            <Setter Property="Background" Value="#383838"/>
            <Setter Property="Foreground" Value="#F3F3F3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#454545"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#454545"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E2E2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 主网格分层：页面内容 + 隐蔽高级设置抽屉面板 -->
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 统一 Windows 标题栏与导航状态 -->
                <RowDefinition Height="*"/>    <!-- 页面核心交互区域 (单向两页切换) -->
            </Grid.RowDefinitions>

            <!-- 1. 顶栏 (UWP TitleBar & Breadcrumb) -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：返回箭头 (仅在详情页显示) + App Logo 与当前状态 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 返回发现页按钮 -->
                    <Button Content="" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="36" Height="36" Margin="0,0,12,0"
                            Style="{StaticResource FluentStandardButton}" Command="{Binding BackToDiscoveryCommand}"
                            Visibility="{Binding CurrentPage, Converter={StaticResource EqualsConv}, ConverterParameter=DeviceDashboard, Converter={StaticResource BoolToVis}}"/>

                    <Border Width="34" Height="34" CornerRadius="6" Background="#2B2B2B" BorderBrush="#383838" BorderThickness="1" Margin="0,0,10,0" Padding="3">
                        <Image Source="Resources/Images/app_logo.png" Stretch="Uniform"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DeviceName}" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            <!-- 胶囊状态小标 -->
                            <Border Background="#107C41" CornerRadius="4" Padding="6,2" Margin="10,0,0,0"
                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="已连接" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#3D3D3D" CornerRadius="4" Padding="6,2" Margin="10,0,0,0"
                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}, ConverterParameter=Rev}">
                                <TextBlock Text="寻找设备中..." FontSize="11" Foreground="#CCCCCC"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="SIBYL MUSIC 电脑版耳机控制中枢 | Windows 10/11 原生 BLE 架构" FontSize="11" Foreground="#9E9E9E"/>
                    </StackPanel>
                </StackPanel>

                <!-- 右侧：隐蔽设置按钮 (小齿轮) 与连接态按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 隐蔽设置齿轮 -->
                    <Button Content="⚙️ 高级选项" Style="{StaticResource FluentStandardButton}" 
                            Command="{Binding ToggleAdvancedSettingsCommand}" Margin="0,0,8,0"/>

                    <Button Content="断开设备" Style="{StaticResource FluentStandardButton}" Command="{Binding DisconnectCommand}"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>

            <!-- 2. 页面 1：周边设备独立发现与自动扫描页 (DeviceDiscovery) -->
            <Grid Grid.Row="1" Visibility="{Binding CurrentPage, Converter={StaticResource EqualsConv}, ConverterParameter=DeviceDiscovery, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 自动扫描提示横幅 -->
                <Border Grid.Row="0" Style="{StaticResource UwpCard}" Padding="16,14" Margin="0,0,0,16">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📡" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="正在持续自动搜索附近的 SIBYL 蓝牙耳机..." FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="请确保耳机已开机并处于配对状态或已在 Windows 系统中配对，点击列表项即可一键建立连接" FontSize="12" Foreground="#9E9E9E"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Content="重新扫描" Command="{Binding ScanCommand}" Style="{StaticResource FluentStandardButton}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- 设备卡片动态列表 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="发现的耳机设备" FontSize="13" FontWeight="SemiBold" Foreground="#A6A6A6" Margin="4,0,0,8"/>

                        <!-- 空提示 -->
                        <Border Style="{StaticResource UwpCard}" Padding="30" Margin="0,10,0,0"
                                Visibility="{Binding DiscoveredDevices.Count, Converter={StaticResource BoolToVis}, ConverterParameter=Rev}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🔍" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="正在扫描周边设备..." FontSize="14" Foreground="#9E9E9E" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 设备项列表 -->
                        <ItemsControl ItemsSource="{Binding DiscoveredDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource UwpItemCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 耳机图标 -->
                                            <Border Grid.Column="0" Width="40" Height="40" Background="#383838" CornerRadius="6" Margin="0,0,12,0">
                                                <TextBlock Text="🎧" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- 名称与 MAC -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="{Binding Id, StringFormat='地址: {0}'}" FontSize="11" Foreground="#8C8C8C"/>
                                            </StackPanel>

                                            <!-- 信号指示 -->
                                            <Border Grid.Column="2" Background="#242424" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <TextBlock Text="{Binding SignalIcon}" FontSize="12" Foreground="#38BDF8"/>
                                            </Border>

                                            <!-- 连接按钮 -->
                                            <Button Grid.Column="3" Content="连接" Style="{StaticResource FluentAccentButton}" 
                                                    Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" VerticalAlignment="Center" Padding="18,6"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 3. 页面 2：耳机深度控制中枢 (DeviceDashboard) -->
            <Grid Grid.Row="1" Visibility="{Binding CurrentPage, Converter={StaticResource EqualsConv}, ConverterParameter=DeviceDashboard, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/> <!-- 左栏：造型与电量 + ANC + 快速切换 -->
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>   <!-- 右栏：10段专业EQ + 白噪音 + 手势映射 -->
                </Grid.ColumnDefinitions>

                <!-- 左栏 -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 卡片 1: 真实矢量外观与电量环 -->
                        <Border Style="{StaticResource UwpCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="设备状态与电量" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentProfile.ChipDescription}" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>

                                <UniformGrid Columns="3">
                                    <controls:EarbudVisualControl Battery="{Binding LeftBattery}" Label="左耳 (L)" IsCharging="{Binding IsLeftCharging}" IsRightSide="False"/>
                                    <controls:EarbudVisualControl Battery="{Binding RightBattery}" Label="右耳 (R)" IsCharging="{Binding IsRightCharging}" IsRightSide="True"/>
                                    <controls:EarbudVisualControl Battery="{Binding CaseBattery}" Label="充电盒" IsCharging="{Binding IsCaseCharging}" IsCaseMode="True"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- 卡片 2: ANC 降噪胶囊控制 (UWP 胶囊式排布) -->
                        <Border Style="{StaticResource UwpCard}">
                            <StackPanel>
                                <TextBlock Text="降噪控制 (ANC)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="🛡️ 降噪" Command="{Binding SetAncCommand}" CommandParameter="1" 
                                            Style="{StaticResource FluentStandardButton}" Margin="0,0,3,0"/>
                                    <Button Grid.Column="1" Content="🍃 普通" Command="{Binding SetAncCommand}" CommandParameter="2" 
                                            Style="{StaticResource FluentStandardButton}" Margin="3,0,3,0"/>
                                    <Button Grid.Column="2" Content="🔊 通透" Command="{Binding SetAncCommand}" CommandParameter="3" 
                                            Style="{StaticResource FluentStandardButton}" Margin="3,0,0,0"/>
                                </Grid>
                                <TextBlock Text="降噪深度: 深度消噪 (100%) | 纯 BLE 写入零音频断续" FontSize="11" Foreground="#8C8C8C"/>
                            </StackPanel>
                        </Border>

                        <!-- 卡片 3: 常用快捷功能开关 -->
                        <Border Style="{StaticResource UwpCard}">
                            <StackPanel>
                                <TextBlock Text="功能快捷开关" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <!-- 游戏模式 -->
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="🎮 游戏模式 (38ms 低延迟)" VerticalAlignment="Center"/>
                                    <CheckBox IsChecked="{Binding IsGameMode}" Command="{Binding ToggleGameModeCommand}" 
                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- 触控锁定 -->
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="🔒 触控防误触锁定" VerticalAlignment="Center"/>
                                    <CheckBox IsChecked="{Binding IsTouchDisabled}" Command="{Binding ToggleTouchLockCommand}" 
                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- 寻找耳机 -->
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="🔔 寻找耳机" VerticalAlignment="Center"/>
                                    <Button Content="播放定位音" Command="{Binding ToggleFindEarphoneCommand}" 
                                            Style="{StaticResource FluentStandardButton}" HorizontalAlignment="Right" Padding="10,4"/>
                                </DockPanel>

                                <!-- 定时关机 -->
                                <DockPanel>
                                    <TextBlock Text="⏱️ 定时自动关机" VerticalAlignment="Center"/>
                                    <ComboBox SelectedIndex="0" HorizontalAlignment="Right" Width="100" Background="#383838" Foreground="White">
                                        <ComboBoxItem Content="不开启"/>
                                        <ComboBoxItem Content="15 分钟"/>
                                        <ComboBoxItem Content="30 分钟"/>
                                        <ComboBoxItem Content="60 分钟"/>
                                    </ComboBox>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- 卡片 4: 自带 3 款声学疗愈音频 -->
                        <Border Style="{StaticResource UwpCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="🎵 自带疗愈白噪音" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Content="⏹️ 停止" Command="{Binding StopSoundCommand}" Style="{StaticResource FluentStandardButton}" 
                                            HorizontalAlignment="Right" Padding="8,3"/>
                                </DockPanel>

                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                    <Button Content="🌸 粉红噪音" Command="{Binding PlaySoundCommand}" CommandParameter="{Binding BuiltInSounds[0]}" 
                                            Style="{StaticResource FluentStandardButton}" Margin="0,0,2,0"/>
                                    <Button Content="🐦 森林鸟鸣" Command="{Binding PlaySoundCommand}" CommandParameter="{Binding BuiltInSounds[1]}" 
                                            Style="{StaticResource FluentStandardButton}" Margin="2,0,2,0"/>
                                    <Button Content="🌧️ 淅沥细雨" Command="{Binding PlaySoundCommand}" CommandParameter="{Binding BuiltInSounds[2]}" 
                                            Style="{StaticResource FluentStandardButton}" Margin="2,0,0,0"/>
                                </UniformGrid>

                                <DockPanel>
                                    <TextBlock Text="音量:" FontSize="11" Foreground="#8C8C8C" VerticalAlignment="Center"/>
                                    <Slider Value="{Binding SoundVolume}" Minimum="0" Maximum="1" Width="130" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 右栏 -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 卡片 5: 10 段专业音乐均衡器 (EQ) -->
                        <Border Style="{StaticResource UwpCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="10 段专业音乐均衡器 (EQ)" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="频点 31Hz - 16kHz | 增益 -8dB ~ +8dB (带 80ms 防抖限流)" FontSize="11" Foreground="#8C8C8C"/>
                                    </StackPanel>
                                    <ComboBox ItemsSource="{Binding EqPresets}" SelectedItem="{Binding SelectedEqPreset}" 
                                              DisplayMemberPath="Name" HorizontalAlignment="Right" Width="150" 
                                              Background="#383838" Foreground="White" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- 10个纵向频段滑块 -->
                                <UniformGrid Columns="10" Height="200" Margin="0,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding EqBand0, StringFormat={}{0}dB}" FontSize="10" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                        <Slider Value="{Binding EqBand0}" Minimum="-8" Maximum="8" Orientation="Vertical" Height="150" Margin="0,4"/>
                                        <TextBlock Text="31" FontSize="10" Foreground="#8C8C8C" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding EqBand1, StringFormat={}{0}dB}" FontSize="10" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                        <Slider Value="{Binding EqBand1}" Minimum="-8" Maximum="8" Orientation="Vertical" Height="150" Margin="0,4"/>
                                        <TextBlock Text="62" FontSize="10" Foreground="#8C8C8C" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding EqBand2, StringFormat={}{0}dB}" FontSize="10" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                        <Slider Value="{Binding EqBand2}" Minimum="-8" Maximum="8" Orientation="Vertical" Height="150" Margin="0,4"/>
                                        <TextBlock Text="125" FontSize="10" Foreground="#8C8C8C" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding EqBand3, StringFormat={}{0}dB}" FontSize="10" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                        <Slider Value="{Binding EqBand3}" Minimum="-8" Maximum="8" Orientation="Vertical" Height="150" Margin="0,4"/>
                                        <TextBlock Text="250" FontSize="10" Foreground="#8C8C8C" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding EqBand4, StringFormat={}{0}dB}" FontSize="10" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                        <Slider Value="{Binding EqBand4}" Minimum="-8" Maximum="8" Orientation="Vertical" Height="150" Margin="0,4"/>
                                        <TextBlock Text="500" FontSize="10" Foreground="#8C8C8C" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding EqBand5, StringFormat={}{0}dB}" FontSize="10" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                        <Slider Value="{Binding EqBand5}" Minimum="-8" Maximum="8" Orientation="Vertical" Height="150" Margin="0,4"/>
                                        <TextBlock Text="1k" FontSize="10" Foreground="#8C8C8C" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding EqBand6, StringFormat={}{0}dB}" FontSize="10" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                        <Slider Value="{Binding EqBand6}" Minimum="-8" Maximum="8" Orientation="Vertical" Height="150" Margin="0,4"/>
                                        <TextBlock Text="2k" FontSize="10" Foreground="#8C8C8C" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding EqBand7, StringFormat={}{0}dB}" FontSize="10" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                        <Slider Value="{Binding EqBand7}" Minimum="-8" Maximum="8" Orientation="Vertical" Height="150" Margin="0,4"/>
                                        <TextBlock Text="4k" FontSize="10" Foreground="#8C8C8C" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding EqBand8, StringFormat={}{0}dB}" FontSize="10" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                        <Slider Value="{Binding EqBand8}" Minimum="-8" Maximum="8" Orientation="Vertical" Height="150" Margin="0,4"/>
                                        <TextBlock Text="8k" FontSize="10" Foreground="#8C8C8C" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding EqBand9, StringFormat={}{0}dB}" FontSize="10" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                        <Slider Value="{Binding EqBand9}" Minimum="-8" Maximum="8" Orientation="Vertical" Height="150" Margin="0,4"/>
                                        <TextBlock Text="16k" FontSize="10" Foreground="#8C8C8C" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- 卡片 6: 按键触控自定义 & 炫彩灯效控制 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左手势 -->
                            <Border Grid.Column="0" Style="{StaticResource UwpCard}">
                                <StackPanel>
                                    <TextBlock Text="按键触控自定义" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="左耳双击:" VerticalAlignment="Center" FontSize="12"/>
                                        <ComboBox SelectedIndex="1" HorizontalAlignment="Right" Width="110" Background="#383838" Foreground="White">
                                            <ComboBoxItem Content="播放/暂停"/>
                                            <ComboBoxItem Content="上一曲"/>
                                            <ComboBoxItem Content="下一曲"/>
                                            <ComboBoxItem Content="语音助手"/>
                                        </ComboBox>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="右耳双击:" VerticalAlignment="Center" FontSize="12"/>
                                        <ComboBox SelectedIndex="2" HorizontalAlignment="Right" Width="110" Background="#383838" Foreground="White">
                                            <ComboBoxItem Content="播放/暂停"/>
                                            <ComboBoxItem Content="上一曲"/>
                                            <ComboBoxItem Content="下一曲"/>
                                            <ComboBoxItem Content="语音助手"/>
                                        </ComboBox>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="左耳长按:" VerticalAlignment="Center" FontSize="12"/>
                                        <ComboBox SelectedIndex="0" HorizontalAlignment="Right" Width="110" Background="#383838" Foreground="White">
                                            <ComboBoxItem Content="ANC切换"/>
                                            <ComboBoxItem Content="游戏模式"/>
                                            <ComboBoxItem Content="音量+"/>
                                        </ComboBox>
                                    </Grid>
                                    <Button Content="保存手势映射" Command="{Binding SaveKeySettingsCommand}" Style="{StaticResource FluentStandardButton}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 右灯效 -->
                            <Border Grid.Column="2" Style="{StaticResource UwpCard}">
                                <StackPanel>
                                    <TextBlock Text="RGB 炫彩灯效" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <UniformGrid Columns="3" Margin="0,0,0,10">
                                        <RadioButton Content="常亮" GroupName="LightModeUwp" Foreground="White"/>
                                        <RadioButton Content="呼吸" IsChecked="True" GroupName="LightModeUwp" Foreground="White"/>
                                        <RadioButton Content="关闭" GroupName="LightModeUwp" Foreground="White"/>
                                    </UniformGrid>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="呼吸速度:" VerticalAlignment="Center" FontSize="12"/>
                                        <Slider Value="{Binding LightSpeed}" Minimum="0" Maximum="7" Width="100" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="灯光亮度:" VerticalAlignment="Center" FontSize="12"/>
                                        <Slider Value="{Binding LightBrightness}" Minimum="0" Maximum="100" Width="100" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 4. 隐蔽高级设置抽屉 (点击齿轮从右侧滑出，收纳兼容模式和模拟开关) -->
        <Border Width="340" HorizontalAlignment="Right" Background="#252525" BorderBrush="#3D3D3D" BorderThickness="1,0,0,0"
                Visibility="{Binding IsAdvancedSettingsOpen, Converter={StaticResource BoolToVis}}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 抽屉顶栏 -->
                <DockPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="高级设置与协议选项" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="✕" Style="{StaticResource FluentStandardButton}" Command="{Binding ToggleAdvancedSettingsCommand}"
                            Padding="8,2" HorizontalAlignment="Right"/>
                </DockPanel>

                <!-- 抽屉设置项 -->
                <StackPanel Grid.Row="1">
                    <!-- 隐蔽手动型号兼容修改 -->
                    <Border Style="{StaticResource UwpCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="硬件型号能力映射 (兼容覆盖)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="系统默认根据蓝牙广播自动识别，如识别不准可手动覆盖能力：" FontSize="11" Foreground="#8C8C8C" Margin="0,0,0,10"/>
                            <ComboBox ItemsSource="{Binding AllModelProfiles}" SelectedItem="{Binding CurrentProfile}" 
                                      DisplayMemberPath="DisplayName" Background="#383838" Foreground="White" Height="30"/>
                        </StackPanel>
                    </Border>

                    <!-- 蓝牙物理传输内核切换 -->
                    <Border Style="{StaticResource UwpCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="蓝牙通信驱动内核" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="当前处于：" FontSize="11" Foreground="#8C8C8C" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding IsMockMode, Converter={StaticResource BoolToVis}, ConverterParameter='虚拟设备模拟器模式'}" FontWeight="SemiBold" Foreground="#38BDF8"/>
                            <Button Content="切换为真实 Windows WinRT BLE / 模拟模式" Command="{Binding SwitchTransportCommand}" 
                                    Style="{StaticResource FluentStandardButton}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 恢复与重置 -->
                    <Border Style="{StaticResource UwpCard}">
                        <StackPanel>
                            <TextBlock Text="耳机固件重置" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Button Content="恢复默认设置" Command="{Binding ResetDefaultsCommand}" Style="{StaticResource FluentStandardButton}" Margin="0,0,0,8"/>
                            <Button Content="恢复出厂设置" Command="{Binding FactoryResetCommand}" Style="{StaticResource FluentStandardButton}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 抽屉底栏：简要日志 -->
                <TextBlock Grid.Row="2" Text="提示: 控制台窗口实时输出底层通信帧日志" FontSize="11" Foreground="#6E6E6E" HorizontalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
