<Page
    x:Class="SibylEarbuds.App.Views.DeviceDiscoveryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:SibylEarbuds.App.Converters"
    xmlns:transport="using:SibylEarbuds.Core.Transport"
    Background="Transparent">

    <Grid Margin="24,12,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            Grid.Row="0"
            Margin="0,0,0,16"
            IsOpen="{x:Bind Vm.IsScanning, Mode=OneWay}"
            IsClosable="False"
            Severity="Informational"
            Title="正在扫描附近的蓝牙音频设备"
            Message="{x:Bind Vm.ScanStatusText, Mode=OneWay}" />

        <Grid Grid.Row="1">

            <!-- Device list -->
            <Grid Visibility="{x:Bind conv:VisibilityHelper.Visible(Vm.HasDevices), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,10">
                    <TextBlock
                        Text="附近的耳机与蓝牙设备"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button
                            Content="重新扫描"
                            Style="{StaticResource AppCompactButtonStyle}"
                            Command="{x:Bind Vm.ScanCommand}" />
                        <Button
                            Content="⚙️ 高级选项"
                            Style="{StaticResource AppCompactButtonStyle}"
                            Command="{x:Bind Vm.ToggleAdvancedSettingsCommand}" />
                    </StackPanel>
                </Grid>

                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind Vm.DiscoveredDevices, Mode=OneWay}"
                    SelectionMode="None"
                    ItemContainerStyle="{StaticResource AppDeviceListItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="transport:DiscoveredBleDevice">
                            <Border Style="{StaticResource AppCardStyle}" Padding="14,12">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Width="44"
                                        Height="44"
                                        CornerRadius="8"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}">
                                        <FontIcon Glyph="&#xE7F6;" FontSize="18" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <Border
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="4"
                                                Padding="6,1"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind conv:VisibilityHelper.Visible(IsSibylVerified)}">
                                                <TextBlock
                                                    Text="SIBYL 官方认证"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Id}" Style="{StaticResource AppCaptionStyle}" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{x:Bind SignalIcon}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AppCaptionStyle}" />

                                    <Button
                                        Grid.Column="3"
                                        Content="连接设备"
                                        Style="{StaticResource AppAccentButtonStyle}"
                                        Click="OnConnectDeviceClick" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Empty state -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind conv:VisibilityHelper.Collapsed(Vm.HasDevices), Mode=OneWay}">
                <FontIcon
                    Glyph="&#xE7F6;"
                    FontSize="36"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    Text="正在监听低功耗蓝牙广播..."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Content="重新扫描"
                        Style="{StaticResource AppCompactButtonStyle}"
                        Command="{x:Bind Vm.ScanCommand}"
                        HorizontalAlignment="Center" />
                    <Button
                        Content="⚙️ 高级选项"
                        Style="{StaticResource AppCompactButtonStyle}"
                        Command="{x:Bind Vm.ToggleAdvancedSettingsCommand}"
                        HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
