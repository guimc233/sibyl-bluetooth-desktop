<Application
    x:Class="SibylEarbuds.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BatteryGoodBrush" Color="#FF0F9D58" />
                    <SolidColorBrush x:Key="BatteryMediumBrush" Color="#FFC77700" />
                    <SolidColorBrush x:Key="BatteryLowBrush" Color="#FFD13438" />
                    <SolidColorBrush x:Key="BatteryTrackBrush" Color="#22000000" />

                    <SolidColorBrush x:Key="EarbudBodyBrush" Color="#FFE4E7EC" />
                    <SolidColorBrush x:Key="EarbudBodyStrokeBrush" Color="#FF98A2B3" />
                    <SolidColorBrush x:Key="EarbudStemBrush" Color="#FFD0D5DD" />
                    <SolidColorBrush x:Key="EarbudSurfaceBrush" Color="#FF475467" />
                    <SolidColorBrush x:Key="EarbudLedBrush" Color="#FF0F9D58" />
                    <SolidColorBrush x:Key="EarbudChargingBrush" Color="#FFC77700" />

                    <SolidColorBrush x:Key="AppHeroOverlayBrush" Color="#14000000" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BatteryGoodBrush" Color="#FF3DDC84" />
                    <SolidColorBrush x:Key="BatteryMediumBrush" Color="#FFF2C94C" />
                    <SolidColorBrush x:Key="BatteryLowBrush" Color="#FFF1707A" />
                    <SolidColorBrush x:Key="BatteryTrackBrush" Color="#33FFFFFF" />

                    <SolidColorBrush x:Key="EarbudBodyBrush" Color="#FF2B2F36" />
                    <SolidColorBrush x:Key="EarbudBodyStrokeBrush" Color="#FF5A6472" />
                    <SolidColorBrush x:Key="EarbudStemBrush" Color="#FF1E2228" />
                    <SolidColorBrush x:Key="EarbudSurfaceBrush" Color="#FFB7C0CC" />
                    <SolidColorBrush x:Key="EarbudLedBrush" Color="#FF3DDC84" />
                    <SolidColorBrush x:Key="EarbudChargingBrush" Color="#FFF2C94C" />

                    <SolidColorBrush x:Key="AppHeroOverlayBrush" Color="#33FFFFFF" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="BatteryGoodBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="BatteryMediumBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="BatteryLowBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="BatteryTrackBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

                    <SolidColorBrush x:Key="EarbudBodyBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="EarbudBodyStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="EarbudStemBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="EarbudSurfaceBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="EarbudLedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="EarbudChargingBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

                    <SolidColorBrush x:Key="AppHeroOverlayBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Fluent card surface: acrylic-safe card background + 1px stroke, 8px radius -->
            <Style x:Key="AppCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="AppInsetCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12,10" />
            </Style>

            <Style x:Key="AppSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <Style x:Key="AppCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="AppAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="AppCompactButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="MinHeight" Value="30" />
            </Style>

            <!-- List item wrapper: stretch content, no built-in chrome padding -->
            <Style x:Key="AppDeviceListItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="MinHeight" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
