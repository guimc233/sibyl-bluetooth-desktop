<Page
    x:Class="SibylEarbuds.App.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:SibylEarbuds.App.Converters"
    Background="Transparent">

    <Grid>
        <Frame x:Name="ContentFrame" />

        <!-- Hidden advanced drawer overlay -->
        <Grid Visibility="{x:Bind conv:VisibilityHelper.Visible(Vm.IsAdvancedSettingsOpen), Mode=OneWay}">
            <Border
                Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                Opacity="0.6" />

            <Border
                Width="380"
                HorizontalAlignment="Right"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                Padding="20">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock
                            Text="高级设置与协议选项"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            VerticalAlignment="Center" />
                        <Button
                            HorizontalAlignment="Right"
                            Command="{x:Bind Vm.ToggleAdvancedSettingsCommand}"
                            ToolTipService.ToolTip="关闭"
                            AutomationProperties.Name="关闭高级选项">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource AppCardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="蓝牙通信驱动内核" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind Vm.TransportModeText, Mode=OneWay}"
                                Style="{StaticResource AppCaptionStyle}" />
                            <Button
                                Margin="0,4,0,0"
                                Style="{StaticResource AppCompactButtonStyle}"
                                Content="切换 WinRT BLE / 虚拟模拟器"
                                Command="{x:Bind Vm.SwitchTransportCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource AppCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="耳机固件重置" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Button
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource AppCompactButtonStyle}"
                                Content="恢复默认设置"
                                Command="{x:Bind Vm.ResetDefaultsCommand}" />
                            <Button
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource AppCompactButtonStyle}"
                                Content="恢复出厂设置"
                                Command="{x:Bind Vm.FactoryResetCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Style="{StaticResource AppCardStyle}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="底层通信帧日志" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ListView
                                Grid.Row="1"
                                MinHeight="120"
                                ItemsSource="{x:Bind Vm.LogLines, Mode=OneWay}"
                                SelectionMode="None"
                                FontFamily="Consolas"
                                FontSize="11"
                                AutomationProperties.Name="通信日志">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
